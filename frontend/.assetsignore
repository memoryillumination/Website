# Files in this directory that must never be uploaded as static assets.
# Same syntax as .gitignore. Wrangler deploys from DISK, not from git, so
# .gitignore alone does not keep a file out of a deploy.

# Generated by scripts/gen_frontend_config.py from the local .env. On a dev
# machine it holds the development config (an API URL derived from the page
# hostname), and shipping that would point production at localhost:5000.
# Excluded entirely instead: with no config.js present the page scripts fall
# back to the production API by design, at the cost of one 404 on a deferred
# script tag.
js/config.js
