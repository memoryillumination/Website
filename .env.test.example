# Smoke test environment — copy to .env.test and fill in real values.
# This file is gitignored (.env.* pattern).

# The backend API URL the smoke test will hit
SMOKE_TEST_API_URL=http://127.0.0.1:5000

# Smoke-test user credentials (must match what's in the test DB)
SMOKE_TEST_USER=smoke-test
SMOKE_TEST_PASSWORD=smoke-test-pass
