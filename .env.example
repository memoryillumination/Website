# Copy to .env at the project root and fill in. .env is gitignored.

# Where the frontend is served relative to this API.
#   development -- same machine (frontend :8000, API :5000)
#   production  -- separate hosts (Cloudflare Pages + api.memoryillumination.com)
# Defaults to production when unset, so a missing value fails closed on CORS
# rather than silently allowing localhost in a deployed environment.
DEPLOY_ENV=development

# Where diffusion actually runs for the "Coloring Page" option.
#   modal -- Modal-hosted A100 worker. Asynchronous: /upload-endpoint returns a
#            job id and the client polls /jobs/<id>.
#   local -- flux_1_kontext.py on 127.0.0.1:5001. Synchronous: the PNG comes
#            straight back, so the job/polling path is NOT exercised.
INFERENCE_BACKEND=modal

# Port the frontend dev server listens on. In development the API allows CORS
# from this port on loopback and the RFC1918 private ranges, so a phone or
# another machine can reach the site at http://<lan-ip>:8000.
FRONTEND_PORT=8000

# Optional. Derived from DEPLOY_ENV when unset; set only to override.
# In development API_BASE_URL is derived from the page's own hostname, so
# setting it here pins every client to one address -- usually not what you want.
# SITE_BASE_URL=http://localhost:8000
# API_BASE_URL=http://localhost:5000
# LOCAL_WORKER_URL=http://127.0.0.1:5001/generate

SECRET_KEY=
EMAIL_API_KEY=
RESEND_WEBHOOK_SECRET=

# Modal credentials. The client reads these from the environment, so no
# ~/.modal.toml is needed; the `modal` CLI needs them exported in your shell.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
